---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Η Πρότασή σας Ελήφθη" description="Ευχαριστούμε για την πρότασή σας.">
  <Header />
  <main id="main-content" class="mx-auto max-w-lg px-4 sm:px-6 py-24 text-center">
    <div class="flex justify-center mb-6">
      <div class="flex h-16 w-16 items-center justify-center rounded-full bg-green-100 dark:bg-green-900/50">
        <svg class="h-8 w-8 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
        </svg>
      </div>
    </div>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Ευχαριστούμε!</h1>
    <p class="mt-4 text-gray-600 dark:text-gray-400 leading-relaxed">
      Η πρότασή σας ελήφθη με επιτυχία. Θα την εξετάσουμε και αν πληροί τα κριτήριά μας, θα την προσθέσουμε στον κατάλογο.
    </p>
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <a href={import.meta.env.BASE_URL} class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-green-600 hover:bg-green-700 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:shadow transition-all duration-200">
        Επιστροφή στην Αρχική
      </a>
      <a
        href="https://github.com/iosifidis/librehub.gr/issues"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 hover:bg-gray-50 dark:hover:bg-gray-800 px-5 py-2.5 text-sm font-semibold text-gray-700 dark:text-gray-300 transition-all duration-200"
      >
        <span>GitHub Issues</span>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
        </svg>
      </a>
    </div>
  </main>
  <Footer />
</BaseLayout>
