---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { resolvePath } from '../utils/paths';

const CATEGORIES = [
  "Γραφείο",
  "Παραγωγικότητα",
  "Γραφικά",
  "Επεξεργασία Εικόνας",
  "Διανυσματικά",
  "Ψηφιακή Ζωγραφική",
  "Πολυμέσα",
  "Βίντεο",
  "Επεξεργασία Βίντεο",
  "Streaming",
  "Επεξεργασία Ήχου",
  "3D Μοντελοποίηση",
  "Ανάπτυξη Λογισμικού",
  "Εργαλεία",
  "Εκπαίδευση",
  "Μαθηματικά",
  "Πλατφόρμες Μάθησης",
  "Προγραμματισμός",
  "Cloud",
  "Email",
  "Επικοινωνία",
  "Ιδιωτικότητα",
  "Πλοήγηση",
  "Λειτουργικά Συστήματα",
];
---

<BaseLayout
  title="Προτείνετε Λογισμικό"
  description="Προτείνετε νέο ανοιχτού κώδικα λογισμικό για προσθήκη στον κατάλογό μας."
>
  <Header />

  <main id="main-content" class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumb -->
    <nav class="mb-8 flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400" aria-label="Breadcrumb">
      <a href={resolvePath('/')} class="hover:text-green-600 dark:hover:text-green-400 transition-colors">Αρχική</a>
      <svg class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/>
      </svg>
      <span class="text-gray-900 dark:text-white font-medium" aria-current="page">Προτείνετε Λογισμικό</span>
    </nav>

    <!-- Header -->
    <div class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-green-100 dark:bg-green-900/50">
          <svg class="h-5 w-5 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Προτείνετε Λογισμικό</h1>
      </div>
      <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
        Γνωρίζετε ένα εξαιρετικό λογισμικό ανοιχτού κώδικα που λείπει από τον κατάλογό μας;
        Μπορείτε να το προτείνετε ανοίγοντας ένα GitHub Issue ή συμπληρώνοντας την παρακάτω φόρμα!
      </p>
    </div>

    <!-- GitHub Suggestion Option (Recommended) -->
    <div class="mb-10 rounded-2xl border border-gray-200 dark:border-gray-800 bg-gradient-to-br from-gray-50 via-white to-gray-50 dark:from-gray-900 dark:via-gray-900/90 dark:to-gray-950 p-6 shadow-sm">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
        <div class="flex items-start gap-3.5">
          <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-gray-900 dark:bg-white text-white dark:text-gray-900 shadow-sm mt-0.5">
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
          </div>
          <div>
            <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800 dark:bg-green-950 dark:text-green-300 mb-1">
              Προτεινόμενο
            </div>
            <h2 class="text-base font-bold text-gray-900 dark:text-white">Έχετε λογαριασμό στο GitHub;</h2>
            <p class="text-sm text-gray-600 dark:text-gray-400 mt-1 leading-relaxed">
              Ανοίξτε απευθείας ένα GitHub Issue. Η πρότασή σας θα καταχωρηθεί δημόσια και θα μπορείτε να παρακολουθείτε την πορεία της.
            </p>
          </div>
        </div>
        <a
          href="https://github.com/iosifidis/librehub.gr/issues/new?template=software-suggestion.yml"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-xl bg-gray-900 hover:bg-gray-800 dark:bg-white dark:hover:bg-gray-100 px-5 py-2.5 text-sm font-semibold text-white dark:text-gray-900 shadow-sm transition-all duration-200 hover:shadow"
        >
          <span>Υποβολή στο GitHub</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Divider -->
    <div class="relative my-10 text-center">
      <div class="absolute inset-0 flex items-center" aria-hidden="true">
        <div class="w-full border-t border-gray-200 dark:border-gray-800"></div>
      </div>
      <div class="relative flex justify-center">
        <span class="bg-gray-50 dark:bg-gray-950 px-4 text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-500">
          ή υποβολή μέσω της παρακάτω φόρμας
        </span>
      </div>
    </div>

    <!-- Error message (shown if submission fails) -->
    <div id="form-error" class="hidden mb-6 rounded-xl bg-red-50 dark:bg-red-950/50 border border-red-200 dark:border-red-800 p-4 flex items-start gap-3" role="alert" aria-live="assertive">
      <svg class="h-5 w-5 text-red-600 dark:text-red-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z"/>
      </svg>
      <div>
        <p class="text-sm font-medium text-red-800 dark:text-red-200">Παρουσιάστηκε σφάλμα κατά την αποστολή</p>
        <p class="text-sm text-red-700 dark:text-red-300 mt-0.5">Παρακαλούμε δοκιμάστε ξανά ή εναλλακτικά ανοίξτε ένα GitHub Issue.</p>
      </div>
    </div>

    <!-- Web Form (Email via FormSubmit) -->
    <form
      id="suggest-form"
      action="https://formsubmit.co/eiosifidis@gmail.com"
      method="POST"
      class="space-y-6 rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 sm:p-8 shadow-sm"
    >
      <!-- FormSubmit configuration -->
      <input type="hidden" name="_subject" value="LibreHub: Νέα πρόταση λογισμικού" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="hidden" name="_next" id="form-next-url" value="https://librehub.gr/success" />
      <!-- Honeypot (bot prevention) -->
      <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

      <!-- Required fields note -->
      <p class="text-xs text-gray-500 dark:text-gray-400">
        Τα πεδία με <span aria-hidden="true" class="text-red-500">*</span> είναι υποχρεωτικά.
      </p>

      <!-- OSS Name -->
      <div>
        <label for="oss-name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
          Όνομα Ανοιχτού Λογισμικού <span class="text-red-500" aria-hidden="true">*</span>
        </label>
        <input
          id="oss-name"
          name="Όνομα_Λογισμικού"
          type="text"
          required
          placeholder="π.χ. LibreOffice, Joplin, Nextcloud"
          class="w-full rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2.5 text-sm text-gray-900 dark:text-gray-100 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-600 focus:border-transparent transition-all duration-200"
        />
      </div>

      <!-- Proprietary alternative -->
      <div>
        <label for="proprietary" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
          Εναλλακτικό ποιου εμπορικού/ιδιόκτητου λογισμικού είναι; <span class="text-red-500" aria-hidden="true">*</span>
        </label>
        <input
          id="proprietary"
          name="Εναλλακτικό_Του"
          type="text"
          required
          placeholder="π.χ. Microsoft Office, Adobe Photoshop, Slack"
          class="w-full rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2.5 text-sm text-gray-900 dark:text-gray-100 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-600 focus:border-transparent transition-all duration-200"
        />
      </div>

      <!-- Category -->
      <div>
        <label for="category" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
          Κατηγορία <span class="text-red-500" aria-hidden="true">*</span>
        </label>
        <select
          id="category"
          name="Κατηγορία"
          required
          class="w-full rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2.5 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-600 focus:border-transparent transition-all duration-200"
        >
          <option value="" disabled selected>Επιλέξτε κατηγορία...</option>
          {CATEGORIES.map(cat => (
            <option value={cat}>{cat}</option>
          ))}
          <option value="Άλλο">Άλλο</option>
        </select>
      </div>

      <!-- Website -->
      <div>
        <label for="website" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
          Επίσημη Ιστοσελίδα ή Αποθετήριο Κώδικα
        </label>
        <input
          id="website"
          name="Ιστοσελίδα"
          type="url"
          placeholder="https://example.org"
          class="w-full rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2.5 text-sm text-gray-900 dark:text-gray-100 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-600 focus:border-transparent transition-all duration-200"
        />
      </div>

      <!-- License -->
      <div>
        <label for="license" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
          Άδεια χρήσης
        </label>
        <input
          id="license"
          name="Άδεια_Χρήσης"
          type="text"
          placeholder="π.χ. GPL-3.0, MIT, Apache-2.0, AGPL-3.0"
          class="w-full rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2.5 text-sm text-gray-900 dark:text-gray-100 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-600 focus:border-transparent transition-all duration-200"
        />
      </div>

      <!-- User Email (Optional) -->
      <div>
        <label for="submitter-email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
          Το email σας <span class="text-xs text-gray-400 dark:text-gray-500 font-normal">(προαιρετικό, αν θέλετε να επικοινωνήσουμε μαζί σας)</span>
        </label>
        <input
          id="submitter-email"
          name="email"
          type="email"
          placeholder="your-email@example.com"
          class="w-full rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2.5 text-sm text-gray-900 dark:text-gray-100 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-600 focus:border-transparent transition-all duration-200"
        />
      </div>

      <!-- Message -->
      <div>
        <label for="message" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
          Σχόλια / Πρόσθετες πληροφορίες
        </label>
        <textarea
          id="message"
          name="Σχόλια"
          rows="4"
          placeholder="Περιγράψτε γιατί αυτό το λογισμικό αξίζει να προστεθεί και ποια είναι τα βασικά του χαρακτηριστικά..."
          class="w-full rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2.5 text-sm text-gray-900 dark:text-gray-100 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-600 focus:border-transparent transition-all duration-200 resize-none"
        ></textarea>
      </div>

      <!-- Submit -->
      <div class="pt-2">
        <button
          id="submit-btn"
          type="submit"
          class="w-full flex items-center justify-center gap-2 rounded-xl bg-green-600 hover:bg-green-700 active:bg-green-800 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:shadow-md transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <!-- Spinner (hidden by default) -->
          <svg id="submit-spinner" class="hidden animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <svg id="submit-icon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5"/>
          </svg>
          <span id="submit-text">Υποβολή Πρότασης</span>
        </button>
        <p class="mt-3 text-center text-xs text-gray-400 dark:text-gray-500">
          Η πρόταση θα αποσταλεί απευθείας στην ομάδα διαχείρισης του LibreHub.
        </p>
      </div>
    </form>

    <!-- Info box -->
    <div class="mt-6 rounded-xl bg-blue-50 dark:bg-blue-950/30 border border-blue-200 dark:border-blue-900 p-4">
      <div class="flex items-start gap-3">
        <svg class="h-5 w-5 text-blue-600 dark:text-blue-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z"/>
        </svg>
        <div>
          <p class="text-sm font-medium text-blue-800 dark:text-blue-200">Κριτήρια αποδοχής</p>
          <ul class="mt-1 text-sm text-blue-700 dark:text-blue-300 space-y-1 list-disc list-inside">
            <li>Το λογισμικό πρέπει να διαθέτει εγκεκριμένη ανοιχτή άδεια (OSI ή FSF)</li>
            <li>Να είναι ενεργά αναπτυσσόμενο ή σε συντήρηση</li>
            <li>Να αποτελεί ουσιαστικό εναλλακτικό ιδιόκτητου λογισμικού</li>
          </ul>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  const form = document.getElementById('suggest-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const submitText = document.getElementById('submit-text');
  const submitSpinner = document.getElementById('submit-spinner');
  const submitIcon = document.getElementById('submit-icon');
  const errorBox = document.getElementById('form-error');
  const nextUrlInput = document.getElementById('form-next-url') as HTMLInputElement;
  const baseUrl = import.meta.env.BASE_URL;

  if (nextUrlInput) {
    nextUrlInput.value = `${window.location.origin}${baseUrl}success`;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (submitBtn) submitBtn.disabled = true;
    if (submitText) submitText.textContent = 'Αποστολή...';
    submitSpinner?.classList.remove('hidden');
    submitIcon?.classList.add('hidden');
    errorBox?.classList.add('hidden');

    try {
      const formData = new FormData(form);
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: {
          'Accept': 'application/json'
        }
      });

      if (response.ok) {
        window.location.href = `${baseUrl}success`;
      } else {
        throw new Error('Submission failed');
      }
    } catch {
      // Fallback: If fetch or CORS encounters an issue, submit normally
      if (submitBtn) submitBtn.disabled = false;
      if (submitText) submitText.textContent = 'Υποβολή Πρότασης';
      submitSpinner?.classList.add('hidden');
      submitIcon?.classList.remove('hidden');
      errorBox?.classList.remove('hidden');
    }
  });
</script>
